# Checkpoints and model artifacts
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.ckpt
*.pt
*.pth
*.ckpt

# Experiment outputs (keep registry but not large artifacts)
experiments/*/outputs/
experiments/*/logs/

# Reports figures (generated, can be large)
reports/figures/*.png
reports/figures/*.pdf

# Temporary
*.tmp
*.bak
scratch/
